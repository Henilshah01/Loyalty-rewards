# Copy to server/.env and fill in. NEVER commit the real file.
# Generate secrets with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"

# --- Server ---
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/loyalty
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES=7d
# Keyed hash + checksum secret for reward codes. Changing it invalidates ALL existing codes.
CODE_SECRET=replace-with-a-different-32-plus-random-characters
CLIENT_ORIGIN=http://localhost:5173
# Set true only when running behind a reverse proxy (Render, Railway, nginx) so req.ip is correct
TRUST_PROXY=false

# --- Fraud controls (defaults shown) ---
MAX_FAILED_CLAIMS=5
LOCK_MINUTES=15
MAX_CLAIMS_PER_DAY=20

# --- Seed script (npm run seed) ---
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=change-me-please-123

# --- Client (put in client/.env, only needed for a deployed build) ---
# VITE_API_URL=https://your-api.example.com
